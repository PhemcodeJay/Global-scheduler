# Copy this file to .env and fill in real values before running.
# Never commit .env — it contains secrets.

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Production admin credentials — CHANGE THESE before deployment
ADMIN_EMAIL=admin@gonest.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

PORT=3000
NODE_ENV=production

# Restrict CORS to your frontend domain(s) in production (comma-separated)
# CORS_ORIGIN=https://app.gonest.com

# Auto-booking monitor
SEED_DEMO_DATA=false
AUTO_BOOK_ENABLED=true
AUTO_BOOK_INTERVAL_MS=100

# Optional: set to 'true' when running behind a reverse proxy (nginx/Cloudflare)
TRUST_PROXY=false

# Optional webhook for auto-book alerts (WhatsApp/Telegram/email gateway)
# SLOT_ALERT_WEBHOOK_URL=https://hooks.example.com/gonest
